# ================================
# UNREAL ENGINE CORE
# ================================

# Cache / temporales (NUNCA subir)
DerivedDataCache/
Intermediate/
Saved/

# Builds locales
Build/*

# Mantener configuraciones necesarias de build
!Build/*/
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# ================================
# IDE / SISTEMA
# ================================

.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Mac / Xcode
*.xcodeproj
*.xcworkspace

# ================================
# BINARIOS / COMPILADOS
# ================================

*.exe
*.dll
*.so
*.dylib
*.app
*.ipa

# ================================
# C++ / OBJ (OJO)
# ================================

# ⚠️ SOLO ignora obj de compilación en Source/
Source/**/*.obj

# ================================
# SOURCE ART (OPCIONAL)
# ================================

# Si tienes carpeta de arte crudo que NO quieres subir
SourceArt/

# ================================
# TESTING (TU CASO)
# ================================

Content/Main/TESTING/

# ================================
# OTROS
# ================================

# Logs
*.log

# Temp
*.tmp
*.temp