# ================================
# UNREAL ENGINE CORE
# ================================

# Cache / temporales (NUNCA subir)
DerivedDataCache/
Intermediate/
Saved/

# Builds locales
Build/*

# Mantener configuraciones necesarias de build
!Build/*/
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# ================================
# IDE / SISTEMA
# ================================

.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Mac / Xcode
*.xcodeproj
*.xcworkspace

# ================================
# BINARIOS / COMPILADOS
# ================================

*.exe
*.dll
*.so
*.dylib
*.app
*.ipa

# ================================
# C++ / OBJ (IMPORTANTE)
# ================================

# Solo ignora .obj de compilación dentro de Source
Source/**/*.obj

# ================================
# SOURCE ART (OPCIONAL)
# ================================

# Arte crudo (quítalo si quieres versionarlo)
SourceArt/

# ================================
# TESTING (SANDBOX LOCAL)
# ================================

# Ignora TODO dentro de TESTING
Content/Main/TESTING/*

# PERO permite que la carpeta exista en el repo
!Content/Main/TESTING/.gitkeep

# ================================
# OTROS
# ================================

# Logs
*.log

# Temp files
*.tmp
*.temp